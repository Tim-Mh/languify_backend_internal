APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

FRONTEND_URLS=http://localhost:5173

AUTH_COOKIE_NAME=access_token
AUTH_TOKEN_EXPIRE_MINUTES=43200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OTP_EXPIRE_MINUTES=10
OTP_RESEND_THROTTLE_SECONDS=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase service account key for direct FCM push (bare RN app tokens).
# Unset uses firebase-credentials.json at the project root; set an absolute
# path only to override that.
FIREBASE_CREDENTIALS=

# The iOS app bundle id, accepted as a native Sign in with Apple audience.
# Defaults to us.languify.app when unset.
APPLE_NATIVE_CLIENT_ID=

# Pronunciation audio. Leave unset to use whatever is on PATH; set an absolute
# path when eSpeak NG is installed somewhere the web user cannot see.

# Pronunciation audio (eSpeak NG). Leave as the bare command to use whatever is
# on PATH; give an absolute path when it is installed somewhere the web user
# cannot see. Unset or missing simply means the clients fall back to the
# device's own voice, which is what they did before this existed.
ESPEAK_BINARY=espeak-ng
ESPEAK_WPM=150
# Only needed when eSpeak was built into a home directory rather than installed
# by a package manager: the directory containing `espeak-ng-data`.
# ESPEAK_DATA_PATH=/home/USER/opt/espeak-ng/share
